{
  "name": "blockchain-nft-interactive",
  "version": "1.0.0",
  "packageManager": "pnpm@8.6.12",
  "description": "Comprehensive blockchain/AI/ML integration platform with real wallet connections and smart contracts",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "preview": "vite preview",
    "deploy:near": "bash scripts/deploy-near-soulbound.sh",
    "deploy:solana": "bash scripts/deploy-solana-token-manager.sh",
    "deploy:polkadot": "bash scripts/deploy-polkadot-xcm.sh",
    "storybook": "storybook dev -p 6007 --config-dir apps/web/.storybook",
    "build-storybook": "storybook build",
    "dev:marketplace": "http-server apps/marketplace-frontend -p 3001",
    "clean": "rimraf node_modules dist .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,html,css,json}\""
  },
  "dependencies": {
    "@bitte-ai/chat": "latest",
    "@bitte-ai/react": "latest",
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "@mediapipe/hands": "^0.4.1675469240",
    "@mediapipe/pose": "^0.5.1675469404",
    "@near-wallet-selector/core": "^8.9.0",
    "@near-wallet-selector/wallet-utils": "^8.9.0",
    "@polkadot/api": "^10.9.1",
    "@polkadot/api-contract": "^10.9.1",
    "@polkadot/extension-dapp": "^0.46.5",
    "@polkadot/keyring": "^12.3.2",
    "@polkadot/types": "^10.9.1",
    "@polkadot/util": "^12.3.2",
    "@polkadot/util-crypto": "^12.3.2",
    "@project-serum/anchor": "^0.26.0",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.32",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-wallets": "^0.19.37",
    "@solana/web3.js": "^1.87.6",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow-models/face-landmarks-detection": "^1.0.6",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@types/bn.js": "^5.2.0",
    "@types/protobufjs": "^6.0.0",
    "@types/react-router-dom": "^5.3.3",
    "@web3-storage/access": "^20.3.0",
    "@web3-storage/w3up-client": "^17.3.0",
    "bn.js": "^5.2.2",
    "clsx": "^2.0.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "ipfs-http-client": "^60.0.1",
    "lucide-react": "^0.263.1",
    "near-api-js": "^2.1.4",
    "nft.storage": "^7.2.0",
    "protobufjs-cli": "^2.0.0",
    "react": "^18.2.0",
    "react-aria-components": "^1.14.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.9.6",
    "sonner": "^1.0.3",
    "tailwind-merge": "^1.14.0",
    "uuid": "^13.0.0",
    "web3.storage": "^4.5.5"
  },
  "devDependencies": {
    "tailwindcss": "^3.3.3",
    "turbo": "^2.6.3",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vitest": "^0.34.4",
    "rimraf": "^5.0.5",
    "prettier": "^3.2.5"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}